# Copy this file to .env.local and replace each placeholder with your own value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB=momenique
AUTH_SECRET=<generate-a-long-random-secret>
NEXTAUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# SMTP provider settings. Use port 465 with SMTP_SECURE=true, or port 587 with false.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-password-or-app-password>
EMAIL_FROM=my e-Wish <hello@example.com>
CONTACT_RECIPIENT_EMAIL=

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Optional comma-separated administrator email addresses.
SUPPORT_ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=
